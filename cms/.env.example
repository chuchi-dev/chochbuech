# The settings of `chochbuech-cms serve` in production (genco loads this
# file before it starts the cms, see docs/deploy.md); locally the flags of
# README.md do the same. Paths are relative to cms/.
ZIPP_DB=data/zipp.db
ZIPP_FILES=data/files
# a backup a day (database and files), the last 7 stay
ZIPP_BACKUP_DIR=data/backups
ZIPP_BACKUP_KEEP=7
# the studio and the files
ZIPP_PUBLIC_URL=https://admin.chochbuech.com
# the website: links of the mails (password reset), the sitemaps
ZIPP_SITE_URL=en=https://chochbuech.com
# the token of the crelte server (ENDPOINT_TOKEN in craft/.env), it reads
# all of GraphQL and the users: openssl rand -hex 32
ZIPP_GRAPHQL_TOKEN=
# the crelte server calls the cms on 127.0.0.1 and names the visitor in
# X-Forwarded-For, nginx in front of the studio does the same
ZIPP_TRUSTED_PROXY=127.0.0.1
# the reset and invite mails; genco sets ZIPP_SMTP_URL in the app's
# environment for a send-only address, else smtp://127.0.0.1:25
#ZIPP_SMTP_URL=
ZIPP_MAIL_FROM='Chuchi Recipes <noreply@chochbuech.com>'
