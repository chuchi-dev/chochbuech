# crelte reads its settings from ../craft/.env, there is no Craft here:
# ENDPOINT_URL is the GraphQL api of the cms in ../cms
ENDPOINT_URL=http://127.0.0.1:8090/api/graphql
FRONTEND_URL=http://localhost:8080
# the zipp studio, crelte requires it
CRAFT_BASE_CP_URL=http://127.0.0.1:8090
# the token of `serve` (ZIPP_GRAPHQL_TOKEN), GraphQL is private
ENDPOINT_TOKEN=

# In production (docs/deploy.md) ENDPOINT_URL is the cms's own port on
# 127.0.0.1, not https://admin.chochbuech.com: the logins and the editor
# go there too, and only from 127.0.0.1 the cms trusts X-Forwarded-For.
#ENDPOINT_URL=http://127.0.0.1:<port of admin.chochbuech.com>/api/graphql
#FRONTEND_URL=https://chochbuech.com
#CRAFT_BASE_CP_URL=https://admin.chochbuech.com
#ENDPOINT_TOKEN=<ZIPP_GRAPHQL_TOKEN of cms/.env>
